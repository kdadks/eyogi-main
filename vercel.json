{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/ssh-app",
      "destination": "/ssh-app/index.html"
    },
    {
      "source": "/ssh-app/((?!assets|Images|.*\\..*).*)",
      "destination": "/ssh-app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
