# ============================================
# EYOGI-MAIN (Vite) CONFIGURATION
# ============================================
# Copy this to .env.local and fill in YOUR credentials

# Supabase Project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (only for trusted server-side usage)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APPLICATION URLS
# ============================================

# eyogi-main dev URL
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# SSH University app URL
VITE_SSH_URL=http://localhost:5174

# Production
PROD_APP_URL=https://eyogigurukul.com
PROD_API_URL=https://eyogigurukul.com/api

# ============================================
# EMAIL CONFIGURATION (Microsoft Graph API)
# ============================================

MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_FROM_EMAIL=your-email@company.com
MICROSOFT_FROM_NAME=Your Company Name
REGISTRATION_EMAIL_TO=admin@company.com

# ============================================
# SUPABASE AUTH CONFIGURATION
# ============================================

VITE_AUTH_EMAIL_CONFIRMATION_REQUIRED=true
VITE_AUTH_AUTO_CONFIRM=false

# ============================================
# SUMUP PAYMENT CONFIGURATION
# ============================================

# Sandbox (for localhost and Netlify preview deployments)
# Get these from: https://me.sumup.com/settings/developer?tab=sandboxes
VITE_SUMUP_SANDBOX_KEY=your-sandbox-api-key-here
VITE_SUMUP_SANDBOX_MERCHANT_CODE=your-sandbox-merchant-code-here

# Production (for https://eyogigurukul.com/)
# Get these from: https://me.sumup.com/settings/developer
VITE_SUMUP_PRODUCTION_KEY=your-production-api-key-here
VITE_SUMUP_PRODUCTION_MERCHANT_CODE=your-production-merchant-code-here

# ============================================
# STORAGE CONFIGURATION
# ============================================

VITE_MAX_FILE_SIZE_MEDIA=10
VITE_MAX_FILE_SIZE_COURSE_MATERIALS=100
VITE_MAX_FILE_SIZE_USER_UPLOADS=50
VITE_ALLOWED_MEDIA_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================
# FEATURE FLAGS
# ============================================

VITE_ENABLE_SSH_UNIVERSITY=true
VITE_ENABLE_MEMBERSHIP=true
VITE_ENABLE_BLOG=true
VITE_DEBUG_MODE=false

# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development
