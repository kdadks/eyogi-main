{
  "name": "eyogi",
  "version": "1.0.0",
  "private": true,
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=8192' next build && yarn build:ssh",
    "build:next": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=8192' next build",
    "build:ssh": "cd src/SSH && npm install --include=dev && npx vite build && cd ../.. && node copy-ssh-files.js",
    "build:clean": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=8192' rimraf .next && next build",
    "build:fast": "cross-env NODE_OPTIONS='--no-deprecation --max-old-space-size=8192' NEXT_TELEMETRY_DISABLED=1 next build",
    "postbuild": "echo 'Skipping sitemap generation for faster builds'",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rimraf .next && yarn build && yarn start",
    "clean": "rimraf .next .swc node_modules/.cache",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation yarn install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rimraf node_modules yarn.lock && yarn install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "deploy": "node deploy.js"
  },
